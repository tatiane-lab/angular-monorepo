{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shell/src",
  "tags": ["type:app", "domain:shell"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/shell"],
      "cache": true,
      "options": { "command": "ng build shell" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "ng serve shell" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "ng test libs --watch=false" }
    }
  }
}
